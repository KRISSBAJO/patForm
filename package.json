{
  "name": "patform",
  "version": "0.1.0",
  "private": true,
  "description": "Patform \u2014 typed process blueprint schema, compiler, and workflow runtime",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "compile": "tsx src/cli.ts",
    "check": "tsx src/cli.ts processes/*.blueprint.json",
    "schema": "tsx src/emit-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "spike": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/spike.ts",
    "db:up": "docker run -d --name patform-pg -e POSTGRES_PASSWORD=spike -e POSTGRES_USER=spike -e POSTGRES_DB=patform -p 55801:5432 postgres:17-alpine",
    "db:down": "docker rm -f patform-pg",
    "generate": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/generate.ts",
    "eval": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/eval.ts",
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/seed.ts",
    "api": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/api/server.ts",
    "worker": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/worker.ts",
    "retention": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/retention-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@types/pg": "^8.23.1",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod-to-json-schema": "^3.23.5"
  }
}
