{
  "name": "patform",
  "version": "0.1.0",
  "private": true,
  "description": "Patform \u2014 typed process blueprint schema, compiler, and workflow runtime",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "compile": "tsx src/cli.ts",
    "check": "tsx src/cli.ts processes/*.blueprint.json",
    "schema": "tsx src/emit-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "spike": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/spike.ts",
    "//ports": "15432 and 16379 sit below Windows' ephemeral range. Docker cannot bind a port Windows has reserved, those reservations move on every reboot, and they used to take 55801 and 56379 with them. Check with: netsh int ipv4 show excludedportrange protocol=tcp",
    "db:up": "docker run -d --name patform-pg -e POSTGRES_PASSWORD=spike -e POSTGRES_USER=spike -e POSTGRES_DB=patform -p 15432:5432 postgres:17-alpine",
    "db:down": "docker rm -f patform-pg",
    "generate": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/generate.ts",
    "eval": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/eval.ts",
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/seed.ts",
    "api": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/api/server.ts",
    "worker": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/worker.ts",
    "staging": "tsx src/staging.ts",
    "db:init-empty": "tsx src/init-empty-db.ts",
    "retention": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/retention-cli.ts",
    "send-test": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/send-test.ts",
    "drill": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/drill.ts",
    "support": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/support-cli.ts",
    "a11y": "node scripts/a11y.mjs",
    "data-map": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/privacy-cli.ts map",
    "erase": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/privacy-cli.ts erase",
    "public-api": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/api/public-server.ts",
    "keys": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/key-cli.ts",
    "redis:up": "docker run -d --name patform-redis -p 16379:6379 redis:7-alpine",
    "redis:down": "docker rm -f patform-redis",
    "packs": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/packs-cli.ts",
    "a11y:fixtures": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/account-fixtures.ts",
    "reachable": "node scripts/reachable.mjs",
    "packs:check": "tsx src/packs/check.ts",
    "mail:check": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/mail-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@aws-sdk/client-guardduty": "^3.1138.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@types/pg": "^8.23.1",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod-to-json-schema": "^3.23.5",
    "axe-core": "^4.10.2",
    "playwright": "^1.49.0"
  }
}
