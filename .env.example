# Copy to .env and fill in. .env is gitignored; never commit a real value.

# Renviq gives you this on the database page.
DATABASE_URL=postgresql://rv_user:PASSWORD@db.renviq.com:5432/app?sslmode=require

# Blueprint generation. Either provider works; set the one you have.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_RATES=0.15:0.60        # input:output dollars per million, for cost reports
# API_PORT=3310
# CONSOLE_ORIGIN=http://localhost:3210

# Email. Nothing leaves the machine unless EMAIL_PROVIDER names a provider AND
# that provider's credentials are set. Leave it unset for the console provider,
# which records every message and sends none.
#
# Setting this affects `api`, `worker` and `send-test`. It does NOT affect
# `spike`, `seed` or `eval` — those call suppressDelivery() and say so on
# stdout, because a test harness reading the same file as the server will
# otherwise mail real people the day somebody configures a provider.
# EMAIL_PROVIDER=console | resend | relykit | smtp
MAIL_FROM=noreply@logaxp.com

# resend
RESEND_API_KEY=

# relykit
# RELYKIT_API_KEY=
# RELYKIT_URL=htt

# smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
