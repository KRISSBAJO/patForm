# Copy to .env and fill in. .env is gitignored; never commit a real value.

# Renviq gives you this on the database page.
DATABASE_URL=postgresql://rv_user:PASSWORD@db.renviq.com:5432/app?sslmode=require

# Where `npm run spike` runs. Every proof drops the schema first, so pointing
# it at the database the app uses signs everybody out and empties it. Leave
# unset only where that database is itself throwaway.
# PROOF_DATABASE_URL=postgresql://spike:spike@127.0.0.1:15432/patform_proofs

# Blueprint generation. Either provider works; set the one you have.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_RATES=0.15:0.60        # input:output dollars per million, for cost reports
# API_PORT=3310
# CONSOLE_ORIGIN=http://localhost:3210

# Email. Nothing leaves the machine unless EMAIL_PROVIDER names a provider AND
# that provider's credentials are set. Leave it unset for the console provider,
# which records every message and sends none.
#
# Setting this affects `api`, `worker` and `send-test`. It does NOT affect
# `spike`, `seed` or `eval` — those call suppressDelivery() and say so on
# stdout, because a test harness reading the same file as the server will
# otherwise mail real people the day somebody configures a provider.
# EMAIL_PROVIDER=console | resend | relykit | smtp
MAIL_FROM=noreply@logaxp.com

# Where invitation, verification and password-reset links point.
#
# Set this in every deployment. The default is the dev console, which is
# deliberate: a default that looked like production would send mail whose
# links resolve to a host that is not serving this deployment — and that
# fails silently, because the message arrives and looks right.
APP_URL=http://localhost:3210

# resend
RESEND_API_KEY=

# relykit
# RELYKIT_API_KEY=
#
# Delivery notifications come back the other way: bounces, complaints and
# confirmed deliveries, signed with this secret. Without it the endpoint
# answers 503 rather than trusting an unsigned caller, because one that did
# would be a way to mark anybody's address as bounced.
# RELYKIT_WEBHOOK_SECRET=
# RELYKIT_URL=htt

# smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# A real account in the seeded workspace, alongside the example.test ones.
# Set both or neither; the address is not committed and this password is not
# the shared dev one, because it opens a mailbox that exists.
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=

# Structured logs, off by default because the CLIs are read by people.
# PATFORM_LOG=json

# Client tools for the recovery drill, when the ones on PATH are older than
# the server. pg_dump refuses a server newer than itself.
# PG_BIN=C:\Program Files\PostgreSQLin

# A rate-limit counter shared across API processes (§10.1). Without it the
# limit is per process, which behind more than one is a limit in name only.
# An unreachable Redis falls back to the local counter rather than refusing
# every request — a cache outage should not become a total outage.
# REDIS_URL=redis://localhost:16379
# PUBLIC_API_PORT=3320
# PUBLIC_API_RATE_LIMIT=120

# Signs the ticket each public form carries (runtime/screening.ts). Required
# in production: without a fixed key every restart invalidates the forms
# people have open, and their submissions are held as suspected spam. At
# least 32 characters; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# FORM_TICKET_SECRET=

# Where the worker emails a bounce- or complaint-rate alert (delivery-health.ts).
# Without it the alert is only a log line. Send it to whoever owns the email
# provider account — a suspension stops every workspace, not one.
# OPS_ALERT_EMAIL=

# Encrypts two-factor secrets at rest (runtime/secret-box.ts). Required in
# production: without it a copy of the database is enough to pass anybody's
# second factor. 32 bytes, base64; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate, move the old value to MFA_ENCRYPTION_KEY_PREVIOUS and set a new
# one; each secret is moved to the new key the next time it is used.
# MFA_ENCRYPTION_KEY=
# MFA_ENCRYPTION_KEY_PREVIOUS=
