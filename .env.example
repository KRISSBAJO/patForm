# Copy to .env and fill in. .env is gitignored; never commit a real value.

# Renviq gives you this on the database page.
DATABASE_URL=postgresql://rv_user:PASSWORD@db.renviq.com:5432/app?sslmode=require

# Blueprint generation. Either provider works; set the one you have.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_RATES=0.15:0.60        # input:output dollars per million, for cost reports
# API_PORT=3310
# CONSOLE_ORIGIN=http://localhost:3210

# Email. BOTH are needed before anything leaves the machine.
# EMAIL_PROVIDER=relykit
# RELYKIT_API_KEY=rlk_live_...
# RELYKIT_URL=https://api.relykit.com
# EMAIL_FROM=no-reply@your-verified-domain
